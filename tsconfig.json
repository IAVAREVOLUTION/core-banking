{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* JSX */
    "jsx": "react-jsx",

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "/utils/supabase/info": ["./utils/supabase/info.tsx"]
    }
  },
  "include": ["src", "utils"],
  // src/imports son notas y borradores de especificaciones (.md/.ts sueltos), no código
  // de la app; varios no compilan y hacían que tsc se detuviera sin revisar el resto.
  "exclude": ["src/imports"]
}
